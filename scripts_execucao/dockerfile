# ─────────────────────────────────────────────────────────────────
# tucuman — Ambiente de reprodução dos experimentos
#
# Uso:
#    docker build -t tucuman .
#    docker run -it --rm -v $(pwd):/repo tucuman
# ─────────────────────────────────────────────────────────────────

FROM ubuntu:22.04

LABEL maintainer="PPGEE/UFAM"
LABEL description="tucuman — Verificação Formal de Alinhamento de Memória"

ENV DEBIAN_FRONTEND=noninteractive

# ── dependências do sistema e ferramentas ─────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    cbmc \
    gcc \
    clang \
    default-jre \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── dependências Python ───────────────────────────────────────────
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

WORKDIR /repo

# Shell interativo para o usuário chamar os scripts individualmente
CMD ["/bin/bash"]
